<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageId>console-with-tests</PackageId>
    <Title>Console App with xUnit v3 Tests Template</Title>
    <Authors>mrviduus</Authors>
    <Description>A production-ready .NET template that creates a console application with xUnit v3 test project structure, following best practices and clean architecture.</Description>
    <PackageTags>dotnet-new;templates;console;xunit;testing;tdd;unit-tests</PackageTags>
    <PackageProjectUrl>https://github.com/mrviduus/ConsoleWithTests.Template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrviduus/ConsoleWithTests.Template</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128;NU5046</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include=".template.config\**\*" />
    <Content Include="src\**\*" Exclude="src\**\bin\**;src\**\obj\**" />
    <Content Include="tests\**\*" Exclude="tests\**\bin\**;tests\**\obj\**" />
    <Content Include="ProjectName.sln" />
    <Content Include=".editorconfig" />
    <Content Include=".gitignore" />
    <Content Include="README.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*" />
    <EmbeddedResource Remove="**\*" />
    <None Remove="**\*" />
  </ItemGroup>

</Project>