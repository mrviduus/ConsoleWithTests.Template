{
  "$schema": "http://json.schemastore.org/template",
  "author": "ConsoleWithTests Contributors",
  "classifications": ["Console", "Test", "xUnit", "Testing", "Solution"],
  "identity": "ConsoleWithTests.Template",
  "name": "Console App with xUnit v3 Tests",
  "shortName": "console-with-tests",
  "description": "A .NET template for creating a console application with xUnit v3 test project, following best practices and clean architecture.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "ProjectName",
  "preferNameDirectory": true,
  "defaultName": "ConsoleApp",
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10.0"
        },
        {
          "choice": "net9.0",
          "description": ".NET 9.0"
        },
        {
          "choice": "net8.0",
          "description": ".NET 8.0"
        }
      ],
      "defaultValue": "net10.0"
    }
  },
  "primaryOutputs": [
    {
      "path": "ProjectName.sln"
    },
    {
      "path": "src/App/App.csproj"
    },
    {
      "path": "tests/App.Tests/App.Tests.csproj"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}